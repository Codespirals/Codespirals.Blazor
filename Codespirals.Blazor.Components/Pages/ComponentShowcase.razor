@namespace Codespirals.Blazor.Pages
@using Codespirals.Blazor.Components
@using Microsoft.AspNetCore.Components.Forms

<h1>Codespirals Components Showcase</h1>

<div class="component-selection">
    <InputSelect @bind-Value="_selected">
        @foreach (var item in Enum.GetValues(typeof(Component)).Cast<Component>())
        {
            <option value="@item">@item</option>
        }
    </InputSelect>
</div>
<div class="fill component-showcase">
    @switch (_selected)
    {
        case Component.Cuboid:
            <div class="fill center-content">
                <Cuboid X="_x" Y="_y" Z="_z" RotateX="_rotateX" RotateY="_rotateY" RotateZ="_rotateZ"></Cuboid>
            </div>
            <div class="component-controls" style="position:absolute;top:0;right:0;display:grid;grid-template-columns:max-content 80px max-content 80px;">
                <label>X</label> <InputNumber @bind-value="_x" />
                <label>Rotate X</label> <InputNumber @bind-value="_rotateX" />
                <label>Y</label> <InputNumber @bind-value="_y" />
                <label>Rotate Y</label> <InputNumber @bind-value="_rotateY" />
                <label>Z</label> <InputNumber @bind-value="_z" />
                <label>Rotate Z</label> <InputNumber @bind-value="_rotateZ" />
            </div>
            break;
        case Component.RotatingDisplay:
            <RotatingDisplay>
                <Cuboid X="_x" Y="_y" Z="_z" RotateX="_rotateX" RotateY="_rotateY" RotateZ="_rotateZ" SideLabel="Side Text">
                    <div>Top label</div>
                </Cuboid>
            </RotatingDisplay>
            <div class="component-controls" style="position:absolute;top:0;right:0;display:grid;grid-template-columns:max-content max-content;">
                <label>X</label> <InputNumber @bind-value="_x" />
                <label>Y</label> <InputNumber @bind-value="_y" />
                <label>Z</label> <InputNumber @bind-value="_z" />
            </div>
            break;
        case Component.RotatableDisplay:
            <h2>Swipe!</h2>
            <RotatableDisplay ContentSize="200">
                <Cuboid X="200" Y="200" Z="200"></Cuboid>
            </RotatableDisplay>
            break;
        case Component.Wedge:
            <RotatingDisplay Paused="true">
                <Wedge X="_x" Y="_y" RotateX="_rotateX" RotateY="_rotateY" RotateZ="_rotateZ">
                    <div class="fill center-content">
                        <span style="font-size:calc(var(--x) * 0.3); width:min-content;color:black;">DO A FLIP!</span>
                    </div>
                </Wedge>
            </RotatingDisplay>
            <div class="component-controls" style="position:absolute;top:0;right:0;display:grid;grid-template-columns:max-content max-content;">
                <label>X</label> <InputNumber @bind-value="_x" />
                <label>Y</label> <InputNumber @bind-value="_y" />
            </div>
            break;
        case Component.RadialText:
            <div class="fill center-content">
                <RadialText Text="@_text" FontSize="_fontSize" Size="_size" Angle="_angle">
                    <img src="images/photos/Cat_on_tower.jpg" />
                </RadialText>
            </div>
            <div class="component-controls" style="position:absolute;top:0;right:0;display:grid;grid-template-columns:max-content 1fr;">
                <label>Text</label> <InputText DisplayName="Text" @bind-value="_text" />
                <label>Font Size</label><InputNumber DisplayName="Font Size" @bind-value="_fontSize"></InputNumber>
                <label>Size</label><InputNumber DisplayName="Size" @bind-value="_size"></InputNumber>
                <label>Angle</label><InputNumber DisplayName="Angle" @bind-value="_angle"></InputNumber>
            </div>
            break;
        case Component.InputWithLabel:
            <div class="component-controls" style="position:sticky;top:0;background-color:black;color:white;display:grid;grid-template-columns:max-content 1fr;">
                <label>Description</label><InputTextArea @bind-Value="_description"></InputTextArea>
                <label>Warning</label><InputTextArea @bind-Value="_warning"></InputTextArea>
                <label>Options (;)</label><InputTextArea @bind-Value="_options"></InputTextArea>
            </div>
            <InputWithLabel Label="Test Text"
                            Description="@_description"
                            Warning="@_warning">
                <InputText @bind-Value="_textInput"></InputText>
            </InputWithLabel>
            <InputWithLabel Label="Test Textarea"
                            Description="@_description"
                            Warning="@_warning">
                <InputTextArea @bind-Value="_textInput"></InputTextArea>
            </InputWithLabel>
            <InputWithLabel Label="Test Number"
                            Description="@_description"
                            Warning="@_warning">
                <InputNumber @bind-Value="_numberInput"></InputNumber>
            </InputWithLabel>
            <InputWithLabel Label="Test Date"
                            Description="@_description"
                            Warning="@_warning">
                <InputDate @bind-Value="_dateInput"></InputDate>
            </InputWithLabel>
            <InputWithLabel Label="Test Checkbox"
                            Description="@_description"
                            Warning="@_warning">
                <InputCheckbox @bind-Value="_boolInput"></InputCheckbox>
            </InputWithLabel>
            <InputWithLabel Label="Test Radio"
                            Description="@_description"
                            Warning="@_warning">
                <InputRadioGroup @bind-value="_radioInput">
                    @foreach (var item in _selectOptions.Select(x => new KeyValuePair<int, string>(_selectOptions.IndexOf(x), x)).ToDictionary())
                    {
                        <InputRadioOption Value="item.Key" Label="@item.Value" Tooltip="This is a radio option"></InputRadioOption>
                    }
                </InputRadioGroup>
            </InputWithLabel>
            <InputWithLabel Label="Test Select"
                            Description="@_description"
                            Warning="@_warning">
                <InputSelect @bind-value="_selectInput">
                    @foreach (var item in _selectOptions.Select(x => new KeyValuePair<int, string>(_selectOptions.IndexOf(x), x)).ToDictionary())
                    {
                        <option value="@item.Key">@item.Value</option>
                    }
                </InputSelect>
            </InputWithLabel>
            break;
        case Component.Sticker:
            <div class="fill center-content">
                <Sticker Rotate="@_rotateX">
                    <div id="pacman"></div>
                </Sticker>
            </div>
            <div class="component-controls" style="position:absolute;top:0;right:0;display:grid;grid-template-columns:max-content 80px;">
                <label>X</label> <InputNumber @bind-value="_x" />
                <label>Y</label> <InputNumber @bind-value="_y" />
                <label>Rotate X</label> <InputNumber @bind-value="_rotateX" />
            </div>
            break;
        default:
            <div class="fill center-content">
                <p>Nothing selected</p>
            </div>
            break;
    }
</div>

@code {
    private Component _selected;

    // cuboid controls
    private int _x = 100;
    private int _y = 100;
    private int _z = 100;
    private int _rotateX = 60;
    private int _rotateY = 0;
    private int _rotateZ = 45;

    // Radial text controls
    private string _text = "Testing Radial Text";
    private int _fontSize = 16;
    private int _size = 200;
    private int _angle = 180;

    // Input with labels
    private string _description = "This is a description of this field. It's long and winding and almost nobody actually reads it, but hey maybe it helps someone.";
    private string _warning = "This is an additional warning about this field. It should be short and snappy.";
    private string _options = "A;B;C";
    private string[] _selectOptions => _options.Split(';');

    private string _textInput = "";
    private int _numberInput = 1;
    private bool _boolInput;
    private DateTime _dateInput = DateTime.UtcNow;
    private int _selectInput;
    private int _radioInput;

    // sticker
    private string _stickerSize => $"height:{_x}px;width:{_y}px;";

    private enum Component
    {
        None,
        Cuboid,
        Wedge,
        RotatingDisplay,
        RotatableDisplay,
        RadialText,
        InputWithLabel,
        Sticker
    }

    [SupplyParameterFromQuery]
    [Parameter]
    public int? InitialComponent { get; set; }

    protected override void OnParametersSet() => _selected = InitialComponent is null ? Component.None : (Component)InitialComponent;
}
