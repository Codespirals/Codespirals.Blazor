@namespace Codespirals.Blazor.Components

<div class="prism-container">
    <div class="prism" style="--total-faces:@NumberOfSideFaces;">
        @for (int i = 0; i < Math.Clamp(NumberOfSideFaces, 3, 1000); i++)
        {
            <div class="prism-face" style="--index:@i;"></div>
        }
    </div>
</div>

@code {
    [Parameter]
    public int NumberOfSideFaces { get; set; }
    public int Height { get; set; }
    public int Width { get; set; }
}
