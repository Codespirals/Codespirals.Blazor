@namespace Codespirals.Blazor.Components

@inherits ThreeDimensionalShape

@implements IHasWidth
@implements IHasHeight
@implements I3DMovable
@implements I3DRotatable
@implements IHasCssClass
@implements IHasColor

<div class="wedge @CssClass" style="@_size @_position @_rotation @_sideLabel @_color">
    <div class="wedge-bottom">
        <div class="wedge-slope">
            <div class="wedge-label">
                @ChildContent
            </div>
        </div>
    </div>
</div>

@code {
    private string _size => $"--x:{X}px;--y:{Math.Max(Y, Z)}px;--z:{Math.Max(Y, Z)}px;";
    private string _position => $"--move-x:{MoveX}px;--move-y:{MoveY}px;--move-z:{MoveZ}px;";
    private string _rotation => $"--rotate-x:{RotateX}deg;--rotate-y:{RotateY}deg;--rotate-z:{RotateZ}deg;";
    private string _sideLabel => $"--label:'{SlopeLabel}';";
    private string _color => $"--color:{Color}";

    [Parameter]
    public string SlopeLabel { get; set; } = "";
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}