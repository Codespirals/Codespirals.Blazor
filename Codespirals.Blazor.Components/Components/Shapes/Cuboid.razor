@namespace Codespirals.Blazor.Components

<div class="cuboid @ExtraClasses" style="@_size @_position @_rotation @_sideLabel @_backgroundImage @_color">
    <div class="cuboid-bottom">
        <div class="cuboid-top">
            <div class="cuboid-label">
                @ChildContent
            </div>
        </div>
    </div>
</div>

@code {
    private string _size => $"--x:{X}{_useXPercentage};--y:{Y}{_useXPercentage};--z:{Z}px;";
    private string _position => $"--move-x:{MoveX}px;--move-y:{MoveY}px;--move-z:{MoveZ}px;";
    private string _rotation => $"--rotate-x:{RotateX}deg;--rotate-y:{RotateY}deg;--rotate-z:{RotateZ}deg;";
    private string _sideLabel => $"--label:'{SideLabel}';";
    private string _backgroundImage => string.IsNullOrWhiteSpace(BackgroundImage) ? $"--background-image:none;" : $"--background-image:url({BackgroundImage});";
    private string _color => $"--color:{Color}";

    private string _useXPercentage => UseXPercentage ? "%" : "px";
    private string _useYPercentage => UseYPercentage ? "%" : "px";

    [Parameter]
    public double X { get; set; } = 100;
    [Parameter]
    public bool UseXPercentage { get; set; }
    [Parameter]
    public double Y { get; set; } = 100;
    [Parameter]
    public bool UseYPercentage { get; set; }
    [Parameter]
    public double Z { get; set; } = 100;
    [Parameter]
    public double MoveX { get; set; }
    [Parameter]
    public double MoveY { get; set; }
    [Parameter]
    public double MoveZ { get; set; }
    [Parameter]
    public double RotateX { get; set; }
    [Parameter]
    public double RotateY { get; set; }
    [Parameter]
    public double RotateZ { get; set; }
    [Parameter]
    public string Color { get; set; } = "#fff";
    [Parameter]
    public string ExtraClasses { get; set; } = "";
    [Parameter]
    public string SideLabel { get; set; } = "";
    [Parameter]
    public string? BackgroundImage { get; set; }
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}