@using Codespirals.Blazor.Components.Interfaces
@namespace Codespirals.Blazor.Components

@implements IHasDimensions
@implements I3DMovable
@implements I3DRotatable
@implements IHasColor
@implements ICanHaveBackgroundImage
@implements IHasCssClass

<div class="cuboid @CssClass" style="@_size @_position @_rotation @_sideLabel @_backgroundImage @_color">
    <div class="cuboid-bottom">
        <div class="cuboid-top">
            <div class="cuboid-label">
                @ChildContent
            </div>
        </div>
    </div>
</div>

@code {
    private string _size => $"--x:{X}px;--y:{Y}px;--z:{Z}px;";
    private string _position => $"--move-x:{MoveX}{_moveXPercentage};--move-y:{MoveY}{_moveYPercentage};--move-z:{MoveZ}px;";
    private string _rotation => $"--rotate-x:{RotateX}deg;--rotate-y:{RotateY}deg;--rotate-z:{RotateZ}deg;";
    private string _sideLabel => $"--label:'{SideLabel}';";
    private string _backgroundImage => string.IsNullOrWhiteSpace(BackgroundImage) ? $"--background-image:none;" : $"--background-image:url({BackgroundImage});";
    private string _color => $"--color:{Color}";

    private string _moveXPercentage => MoveXPercentage ? "%" : "px";
    private string _moveYPercentage => MoveYPercentage ? "%" : "px";

    [Parameter]
    public double X { get; set; } = 100;
    [Parameter]
    public double Y { get; set; } = 100;
    [Parameter]
    public double Z { get; set; } = 100;
    [Parameter]
    public double MoveX { get; set; }
    [Parameter]
    public bool MoveXPercentage { get; set; }
    [Parameter]
    public double MoveY { get; set; }
    [Parameter]
    public bool MoveYPercentage { get; set; }
    [Parameter]
    public double MoveZ { get; set; }
    [Parameter]
    public double RotateX { get; set; }
    [Parameter]
    public double RotateY { get; set; }
    [Parameter]
    public double RotateZ { get; set; }
    [Parameter]
    public string Color { get; set; } = "#fff";
    [Parameter]
    public string CssClass { get; set; } = "";
    [Parameter]
    public string SideLabel { get; set; } = "";
    [Parameter]
    public string? BackgroundImage { get; set; }
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}