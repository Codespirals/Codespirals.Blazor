@namespace Codespirals.Blazor.Components
@using Codespirals.Base.Extensions

<div class="horizontal-scroller-container @ExtraClasses">
    <div class="horizontal-scroller">
        @ChildContent
    </div>
</div>

<script>
    document.getElementsByClassName("horizontal-scroller")[0].addEventListener("wheel", scrollHorizontally);
    function scrollHorizontally(args)
    {   
        if(args.deltaY > 0)
        {
            this.scrollLeft += 75;
        }
        else {
            this.scrollLeft -= 75;
        }
    }
</script>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
    [Parameter]
    public string ExtraClasses { get; set; } = "";
}
