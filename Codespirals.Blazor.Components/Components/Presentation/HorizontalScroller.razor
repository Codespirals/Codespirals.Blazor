@namespace Codespirals.Blazor.Components

@implements IHasCssClass

<div class="horizontal-scroller @CssClass">
    <div class="horizontal-scroller-content">
        @ChildContent
    </div>
</div>

<script>
    document.getElementsByClassName("horizontal-scroller")[0].addEventListener("wheel", scrollHorizontally);
    function scrollHorizontally(args)
    {   
        if(args.deltaY > 0)
        {
            this.scrollLeft += 75;
        }
        else {
            this.scrollLeft -= 75;
        }
    }
</script>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public string CssClass { get; set; } = "";
}
