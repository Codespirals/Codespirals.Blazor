@namespace Codespirals.Blazor.Components

@implements IAbsolutelyPositionable
@implements IHasFontSize
@implements IRotatable

<div class="text-sticker" style="@_fontSize @_rotate @_top @_right @_bottom @_left" role="presentation">
    @Text
</div>

@code {
    [Parameter]
    public required string Text { get; set; }
    [Parameter]
    public int? Top { get; set; }
    [Parameter]
    public int? Bottom { get; set; }
    [Parameter]
    public int? Right { get; set; }
    [Parameter]
    public int? Left { get; set; }
    [Parameter]
    public decimal FontSize { get; set; } = 1;
    [Parameter]
    public double RotateX { get; set; } = Random.Shared.Next(-400, 400) / 10d;

    private string _fontSize => $"font-size:{FontSize}rem;";
    private string _rotate => $"rotate:{RotateX}deg;";
    private string _top => Top is null ? string.Empty : $"top:{Top}px;";
    private string _right => Right is null ? string.Empty : $"right:{Right}px;";
    private string _bottom => Bottom is null ? string.Empty : $"bottom:{Bottom}px;";
    private string _left => Left is null ? string.Empty : $"left:{Left}px;";
}
